{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/chat",  "dest": "/api/index.py" },
    { "src": "/faqs",  "dest": "/api/index.py" },
    { "src": "/",      "dest": "/api/index.py" },
    { "src": "/(.*)",  "dest": "/api/index.py" }
  ]
}
